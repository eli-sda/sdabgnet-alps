<IfModule mod_headers.c>
  Header set Vary "User-Agent"
  Header set Cache-Control "no-cache, no-store, must-revalidate"
  Header set Pragma "no-cache"
  Header set Expires 0

  # Ensure index.html is always fetched fresh
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>

  # Cache static assets for a long time
  <FilesMatch "\.(js|css|jpg|jpeg|png|gif|ico|svg|webp|webm|pdf|woff|woff2|ttf|eot|otf|mp4|ogg|mp3|wav|txt|xml|json)$">
    Header set Cache-Control "max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Set index.php as the default file to load
  DirectoryIndex index.php index.html

  # Exclude meta.php from being rewritten
  RewriteCond %{REQUEST_URI} !^/meta.php$ [NC]

  # Exclude static files (images, icons, PDFs, etc.) from being rewritten
  RewriteCond %{REQUEST_URI} !\.(?:jpg|jpeg|png|gif|ico|svg|webp|pdf|css|js|woff|woff2|ttf|eot|otf|mp4|webm|ogg|mp3|wav|txt|xml|json)$ [NC]

  # Redirect bot requests to meta.php
  RewriteCond %{HTTP_USER_AGENT} "facebookexternalhit|Viber|WhatsApp|Twitterbot|TelegramBot|Slackbot|LinkedInBot" [NC]
  RewriteRule ^(.*)$ /meta.php?path=/$1 [L]

  # Redirect all other requests to index.html (React SPA)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ /index.html [L]
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php73” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php73 .php .php7 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit